stock IsValidVehicleComponent(modelid, componentid)
{
	if(400 <= modelid <= 611)
	{
		switch(componentid)
		{
			case 1000..1191:
			{
				componentid -= 1000;
				if(vmv_Mods[(modelid - 400) * 6 + (componentid >>> 5)] & 1 << (componentid & 0b00011111)) return 1;
			}
			case 1192, 1193:
			{
				if(modelid == 576) return 1;
			}
		}
	}
	return 0;
}

// Components with no model-specific body dummy: safe on launcher custom
// models (whose DFFs lack the ug_ upgrade frames -> client crash in
// CVehicle::CreateUpgradeAtomic/RwFrameAddChild otherwise).
stock IsCustomSafeComponent(componentid)
{
	switch(componentid)
	{
		case 1008, 1009, 1010, 1087: return 1;      // nitro x2/x5/x10, hydraulics
		case 1025, 1073..1085, 1096..1098: return 1; // wheels
	}
	return 0;
}

// Launcher models with body tuning disabled by an admin (/mblock) because
// their DFF lacks the ug_ upgrade frames (client crash otherwise).
#define MAX_BLOCKED_TUNE_MODELS 128
new g_BlockedTuneModels[MAX_BLOCKED_TUNE_MODELS];

stock IsTuneBlockedModel(modelid)
{
	for(new i = 0; i < MAX_BLOCKED_TUNE_MODELS; i++)
		if(g_BlockedTuneModels[i] == modelid) return 1;
	return 0;
}

stock BlockTuneModel(modelid)
{
	if(modelid <= 611 || IsTuneBlockedModel(modelid)) return 0;
	for(new i = 0; i < MAX_BLOCKED_TUNE_MODELS; i++)
		if(g_BlockedTuneModels[i] == 0) { g_BlockedTuneModels[i] = modelid; return 1; }
	return 0;
}

stock UnblockTuneModel(modelid)
{
	for(new i = 0; i < MAX_BLOCKED_TUNE_MODELS; i++)
		if(g_BlockedTuneModels[i] == modelid) { g_BlockedTuneModels[i] = 0; return 1; }
	return 0;
}

// Full safety check: nex-ac table against the server base model. Custom
// launcher display models (disp > 611) are NOT body-tuning safe by default
// because their DFFs lack the ug_ upgrade frames (client crash in
// CVehicle::CreateUpgradeAtomic/RwFrameAddChild). Only the custom-safe
// whitelist (nitro/hydraulics/wheels) is allowed; regular bumpers/spoilers/
// sideskirts/etc. are silently rejected for all custom launcher models.
stock IsVehicleComponentSafe(vehicleid, componentid)
{
	if(!IsValidVehicleComponent(GetVehicleModel(vehicleid), componentid)) return 0;
	new disp = Custom_GetVehicleDisplayModel(vehicleid);
	if(disp > 611 && !IsCustomSafeComponent(componentid)) return 0;
	return 1;
}

stock Safe_AddVehicleComponent(vehicleid, componentid)
{
	if(!IsVehicleComponentSafe(vehicleid, componentid)) return 0;
	return AddVehicleComponent(vehicleid, componentid);
}
